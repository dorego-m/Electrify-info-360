
@model List<Electrify.Models.InformeConsumoDiario>
@using System.Text.Json

@{
    ViewData["Title"] = "Informe de consumo";

    var etiquetas = Model.Select(x => x.Fecha.ToString("dd/MM")).ToArray();
    var consumos = Model.Select(x => x.ConsumoKWhEstimado).ToArray();
    var costos = Model.Select(x => x.CostoEstimado).ToArray();
}

<div class="container py-4">
    <h1 class="mb-2">Informe de consumo</h1>
    <p class="">
        Consumo y costos diarios estimados según los formularios cargados.
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning">@ViewBag.Error</div>
    }

    <div class="d-flex flex-wrap gap-2 mb-3">
    <button type="button" class="btn btn-outline-primary"
            data-periodo="dia">
        Día
    </button>

    <button type="button" class="btn btn-outline-primary"
            data-periodo="semana">
        Semana
    </button>

    <button type="button" class="btn btn-outline-primary"
            data-periodo="mes">
        Mes
    </button>

    <button type="button" class="btn btn-outline-primary"
            data-periodo="anio">
        Año
    </button>
</div>

    <form method="get" asp-action="InformeConsumo"
          class="row g-3 align-items-end mb-4">
        <div class="col-md-4">
            <label for="fechaInicio" class="form-label">Desde</label>
            <input type="date" id="fechaInicio" name="fechaInicio"
                   value="@ViewBag.FechaInicio"
                   class="form-control" required />
        </div>

        <div class="col-md-4">
            <label for="fechaFin" class="form-label">Hasta</label>
            <input type="date" id="fechaFin" name="fechaFin"
                   value="@ViewBag.FechaFin"
                   class="form-control" required />
        </div>

        <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100">
                Generar informe
            </button>
        </div>
    </form>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <p class=" mb-1">Consumo estimado</p>
                    <h3 id="consumoTotal">@(((decimal)ViewBag.ConsumoTotal).ToString("N2")) kWh</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <p class=" mb-1">Costo estimado</p>
                    <h3 id="costoTotal">$ @(((decimal)ViewBag.CostoTotal).ToString("N2"))</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <p class=" mb-1">Promedio diario</p>
                    <h3 id="promedioDiario">@(((decimal)ViewBag.PromedioDiario).ToString("N2")) kWh</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">Consumo por día</h2>
            <canvas id="graficoConsumo"></canvas>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">Costo estimado por día</h2>
            <canvas id="graficoCosto"></canvas>
        </div>
    </div>

    
<div class="row g-4 mt-2">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Consumo por sector</h2>
                <canvas id="graficoSectores"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Consumo por dispositivo</h2>
                <canvas id="graficoDispositivos"></canvas>
            </div>
        </div>
    </div>
</div>


    <p class=" small mt-3">
        Los valores diarios son estimaciones distribuidas uniformemente
        entre los días de cada formulario, no mediciones reales.
    </p>

<div id="datosInforme"
     data-etiquetas="@System.Text.Json.JsonSerializer.Serialize(etiquetas)"
     data-consumos="@System.Text.Json.JsonSerializer.Serialize(consumos)"
     data-costos="@System.Text.Json.JsonSerializer.Serialize(costos)"
     data-sectores="@System.Text.Json.JsonSerializer.Serialize(ViewBag.Sectores)"
     data-dispositivos="@System.Text.Json.JsonSerializer.Serialize(ViewBag.Dispositivos)">
</div>

</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/informe-consumo.js" asp-append-version="true"></script>
}