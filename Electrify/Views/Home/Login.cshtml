@{
    ViewData["Title"] = "Iniciar sesion";
    var error = ViewBag.Error as string;
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="text-center">Iniciar sesion</h1>
        <p class="text-center">Ingresa a tu cuenta de Electrify.</p>
        <form asp-controller="Home" asp-action="Login" method="post" id="formLogin" novalidate>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" name="email" id="email" class="form-control" maxlength="100" required />
                <small class="text-danger" id="errorEmail"></small>
            </div>
            <div class="mb-3">
                <label for="contraseña" class="form-label">Contraseña</label>
                <input type="password" name="contraseña" id="contraseña" class="form-control" required />
                <small class="text-danger" id="errorContraseña"></small>
            </div>
            <button type="submit" class="btn btn-primary w-100">Entrar</button>
        </form>
        @if (!string.IsNullOrEmpty(error))
        {
            <p class="text-danger mt-3">@error</p>
        }
        <p class="mt-3 text-center">¿No tenes cuenta? <a asp-action="CrearCuenta">Registrate aqui</a></p>
    </div>
</div>
<script src="~/js/validaciones-auth.js" asp-append-version="true"></script>
