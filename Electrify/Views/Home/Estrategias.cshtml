
@model Electrify.Models.EstrategiasViewModel

@{
    ViewData["Title"] = "Estrategias de Consumo";
}

<div class="container-fluid estrategias-container">
    <h1 class="mb-4">Estrategias de Consumo</h1>

   @if (TempData["MensajeEstrategia"] != null)
{
    var tipoMensaje = TempData["TipoMensajeEstrategia"]?.ToString() ?? "success";

    <div class="alert alert-@tipoMensaje">
        @TempData["MensajeEstrategia"]
    </div>
}

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="estrategia-panel">
                <h5>▥ Diagnóstico energético</h5>
                <p class="mt-3 fw-bold">@Model.Diagnostico</p>

                @if (!string.IsNullOrEmpty(Model.RecomendacionPrincipal))
                {
                    <div class="oportunidad">
                        <strong>Oportunidad de mejora</strong>
                        <p class="mb-0">@Model.RecomendacionPrincipal</p>
                    </div>
                }
            </div>

            <div class="estrategia-panel mt-3">
                <h5>Estrategias recomendadas</h5>

                @{var recomendaciones = new[]
                {
                    new {
                        Tipo = "climatizacion",
                        Nombre = "Ajuste de climatización",
                        Titulo = "Ajuste de climatización",
                        Texto = "Revisá los horarios y la configuración de los equipos de climatización."
                    },
                    new {
                        Tipo = "iluminacion",
                        Nombre = "Ajuste de iluminación",
                        Titulo = "Ajuste de iluminación",
                        Texto = "Aprovechá la luz natural y revisá los horarios de iluminación."
                    },
                    new {
                        Tipo = "horarios",
                        Nombre = "Control de horarios",
                        Titulo = "Controlá tus horarios",
                        Texto = "Identificá los dispositivos que funcionan fuera del horario laboral."
                    },
                    new {
                        Tipo = "equipos",
                        Nombre = "Ahorro de energía",
                        Titulo = "Ahorro de energía",
                        Texto = "Revisá qué equipos permanecen encendidos cuando no se utilizan."
                    }
                };
            }

            @foreach (var item in recomendaciones)
            {
                bool yaAplicada = Model.EstrategiasAplicadas.Any(
                    e => e.Nombre == item.Nombre && e.Estado == "Aplicada"
                );

                <div class="recomendacion-item">
                    <div>
                        <strong>@item.Titulo</strong>
                        <p>@item.Texto</p>
                    </div>

                    @if (yaAplicada)
                    {
                        <span class="badge bg-success">Aplicada</span>
                    }
                    else
                    {
                        <form asp-action="AplicarEstrategia" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="tipo" value="@item.Tipo" />
                            <button class="btn btn-sm btn-success" type="submit">
                                Aplicar
                            </button>
                        </form>
                    }
                </div>
            }
            </div>
        </div>

        <div class="col-lg-7">
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="estrategia-kpi">
                        <small>Consumo estimado</small>
                        <h3>@Model.ConsumoTotal.ToString("N2") kWh</h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="estrategia-kpi">
                        <small>Costo estimado</small>
                        <h3>$ @Model.CostoTotal.ToString("N2")</h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="estrategia-kpi">
                        <small>Dispositivos registrados</small>
                        <h3>@Model.Dispositivos.Count</h3>
                    </div>
                </div>
            </div>

            <div class="estrategia-panel">
                <h5>Consumo estimado por sector</h5>

                @if (Model.Sectores.Any())
                {
                    <canvas id="graficoEstrategias"></canvas>
                }
                else
                {
                    <p class="text-secondary">
                        Todavía no hay consumos para mostrar.
                    </p>
                }
            </div>

            <div class="estrategia-panel mt-3">
                <h5>Dispositivos con mayor consumo</h5>

                @if (Model.Dispositivos.Any())
                {
                    @foreach (var dispositivo in Model.Dispositivos.Take(5))
                    {
                        <div class="dispositivo-consumo">
                            <div>
                                <strong>@dispositivo.Nombre</strong>
                                <small>@dispositivo.Tipo</small>
                            </div>
                            <div class="text-end">
                                <strong>@dispositivo.ConsumoKWh.ToString("N2") kWh</strong>
                                <small>@dispositivo.Porcentaje.ToString("N1")%</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-secondary">
                        No hay dispositivos con consumos registrados.
                    </p>
                }
            </div>
        </div>
    </div>

    <div class="estrategia-panel mt-4">
    <h5>Historial de estrategias</h5>

    @if (Model.EstrategiasAplicadas.Any())
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle">
                <thead>
                    <tr>
                        <th>Estrategia</th>
                        <th>Descripción</th>
                        <th>Fecha de inicio</th>
                        <th>Fecha de finalización</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var estrategia in Model.EstrategiasAplicadas)
                    {
                        <tr>
                            <td>@estrategia.Nombre</td>
                            <td>@estrategia.Descripcion</td>
                            <td>@estrategia.FechaInicio.ToString("dd/MM/yyyy")</td>

                            <td>
                                @(estrategia.FechaFin.HasValue
                                    ? estrategia.FechaFin.Value.ToString("dd/MM/yyyy")
                                    : "-")
                            </td>

                            <td>
                                @if (estrategia.Estado == "Aplicada")
                                {
                                    <span class="badge bg-success">Aplicada</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Desactivada</span>
                                }
                            </td>

                            <td>
                                @if (estrategia.Estado == "Aplicada")
                                {
                                    <form asp-action="DesactivarEstrategia" method="post"
                                          onsubmit="return confirm('¿Querés desactivar esta estrategia?');">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="idEstrategia"
                                               value="@estrategia.IDEstrategia" />

                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Desactivar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-secondary">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-secondary mb-0">
            Todavía no aplicaste ninguna estrategia.
        </p>
    }
</div>
</div>

<div id="datosEstrategias"
     data-sectores="@System.Text.Json.JsonSerializer.Serialize(Model.Sectores)">
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/estrategias.js" asp-append-version="true"></script>
}