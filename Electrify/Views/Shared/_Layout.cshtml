@{
    bool hayUsuario = !string.IsNullOrEmpty(Context.Session.GetString("Email"));
    bool esInicio = ViewData["Inicio"] != null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Electrify</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Electrify.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="header-izq">
            <a class="logo" href='@Url.Action("Index", "Home")'>
                <img src="~/img/LogoElectrifyPNG.png" alt="Logo de Electrify">
       
            </a>
        </div>

        <nav class="header-centro">
            @if (hayUsuario)
            {
                <a class="boton-menu" href='@Url.Action("Index", "Home")'>Home</a>
                <a class="boton-menu" href='@Url.Action("InformeConsumo", "Home")'>Informes</a>
                <a class="boton-menu" href='@Url.Action("Estrategias", "Home")'>Estrategias</a>
            }
        </nav>

        <div class="header-der">
            @if (hayUsuario)
            {
                <a class="link-usuario" href='@Url.Action("Usuario", "Home")'>@Context.Session.GetString("Nombre")</a>
                <form method="post" action='@Url.Action("Logout", "Home")'>
                    <button class="boton-salir" type="submit">Cerrar sesión</button>
                </form>
            }
            else
            {
                <a class="link-login" href='@Url.Action("Login", "Home")'>Log In</a>
            }
  
        </div>


    </header>

    @if (esInicio)
    {
        <main class="principal-completo">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>